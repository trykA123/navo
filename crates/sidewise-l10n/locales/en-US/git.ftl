# Strings of Git compare: the Start chip and tip, and the Folders notice.
git-chip-revision = Git revision
git-chip-not-repository = Not a Git repository
git-chip-no-revision = No such revision
git-chip-unsupported = This repository format is not supported
git-chip-broken = This repository cannot be read
git-start-tip = Add @branch, @tag or @commit to a repository folder to compare a Git revision.
git-side-no-file = This side is Git revision { $rev }; it has no file on disk.